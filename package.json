{
  "name": "prusalink-card",
  "version": "0.2.0",
  "description": "Home Assistant Lovelace card for PrusaLink printers with an animated printer",
  "type": "module",
  "main": "dist/prusalink-card.js",
  "license": "MIT",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c --watch",
    "dev": "rollup -c --watch --environment DEV",
